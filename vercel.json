{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/fb-tr/:path*",
      "destination": "/api?_p=/:path*"
    },
    {
      "source": "/tiktok-sdk/:path*",
      "destination": "/api?_p=/:path*"
    },
    {
      "source": "/api-proxy/:path*",
      "destination": "/api?_p=/:path*"
    },
    {
      "source": "/api/apipay/webhook",
      "destination": "/api?_p=/api/apipay/webhook"
    },
    {
      "source": "/api/apipay/redirect-verify",
      "destination": "/api?_p=/api/apipay/redirect-verify"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?_p=/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
